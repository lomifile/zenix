# zenix: fzf styled to match the Xcode palette.
#
# Read via $FZF_DEFAULT_OPTS_FILE, set in zsh/.zshrc. One option per line,
# comments allowed -- which is why this is a file rather than a wall of
# backslashes in FZF_DEFAULT_OPTS.

# Spotlight-shaped: prompt on top, results below, floating rather than a strip
# glued to the bottom of the pane.
--layout=reverse
--height=45%
--border=rounded
--margin=1,2
--padding=0,1

# Inside tmux, open as a centred popup instead of taking over the pane. Drop
# this line to get the in-pane strip back; it has no effect outside tmux.
--tmux=center,80%,60%

--info=right
--separator=─
--scrollbar=│
--prompt='󰍉  '
--pointer=▍
--marker=✓
--highlight-line
--cycle

# >>> zenix theme <<<
--color=fg:#bac2de,bg:#1e1e2e,hl:#89b4fa
--color=fg+:#cdd6f4,bg+:#45475a,hl+:#89b4fa
--color=info:#6c7086,border:#313244,separator:#313244
--color=prompt:#89b4fa,pointer:#a6e3a1,marker:#fab387
--color=spinner:#b4befe,header:#6c7086,label:#bac2de
--color=query:#cdd6f4,scrollbar:#313244,gutter:#1e1e2e
--color=preview-fg:#bac2de,preview-bg:#1e1e2e,preview-border:#313244
# >>> end zenix theme <<<
