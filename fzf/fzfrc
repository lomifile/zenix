# zenix: fzf styled to match the Xcode palette.
#
# Read via $FZF_DEFAULT_OPTS_FILE, set in zsh/.zshrc. One option per line,
# comments allowed -- which is why this is a file rather than a wall of
# backslashes in FZF_DEFAULT_OPTS.

# Spotlight-shaped: prompt on top, results below, floating rather than a strip
# glued to the bottom of the pane.
--layout=reverse
--height=45%
--border=rounded
--margin=1,2
--padding=0,1

# Inside tmux, open as a centred popup instead of taking over the pane. Drop
# this line to get the in-pane strip back; it has no effect outside tmux.
--tmux=center,80%,60%

--info=right
--separator=─
--scrollbar=│
--prompt='󰍉  '
--pointer=▍
--marker=✓
--highlight-line
--cycle

# >>> zenix theme <<<
--color=fg:#b8c0e0,bg:#24273a,hl:#8aadf4
--color=fg+:#cad3f5,bg+:#494d64,hl+:#8aadf4
--color=info:#6e738d,border:#363a4f,separator:#363a4f
--color=prompt:#8aadf4,pointer:#a6da95,marker:#f5a97f
--color=spinner:#b7bdf8,header:#6e738d,label:#b8c0e0
--color=query:#cad3f5,scrollbar:#363a4f,gutter:#24273a
--color=preview-fg:#b8c0e0,preview-bg:#24273a,preview-border:#363a4f
# >>> end zenix theme <<<
