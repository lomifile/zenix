pragma Singleton

import QtQuick

// Generated by `zenix theme set catppuccin-mocha` -- edit themes/catppuccin-mocha.json, not this.
//
// One palette for every shell surface. These are the values hyprlock.conf and
// waybar-style.css already use, so a popup summoned over the bar reads as part
// of the same desktop rather than as a separate app.
QtObject {
  // Surfaces. `background` is the card itself, deliberately not opaque: the
  // layer rule in hyprland.lua blurs whatever sits behind it.
  readonly property color background: "#ec1e1e2e"
  readonly property color elevated: "#14cdd6f4"
  readonly property color scrim: "#6611111b"

  // Hairlines. `border` outlines the card, `separator` divides rows inside it.
  readonly property color border: "#26cdd6f4"
  readonly property color separator: "#14cdd6f4"

  // Text. `muted` is the secondary line under a title; `faint` is for hints
  // that should register only when looked at directly.
  readonly property color foreground: "#cdd6f4"
  readonly property color muted: "#a6adc8"
  readonly property color faint: "#6c7086"

  readonly property color accent: "#89b4fa"
  readonly property color selection: "#3d89b4fa"

  // Text and glyphs that sit *on* an accent fill. Not always white: on a light
  // accent -- any of the Catppuccin blues -- white reads as a smudge, so this
  // flips to the darkest surface instead.
  readonly property color accentForeground: "#11111b"

  // Overlay washes, lightest first. Named by weight rather than by use so one
  // value can serve a fill and a hairline alike. They stay alpha rather than
  // becoming opaque surfaces: the cards are blurred by the layer rule in
  // hyprland.lua, and an opaque fill would throw that away.
  readonly property color washFaint: "#0dcdd6f4"
  readonly property color washDim: "#12cdd6f4"
  readonly property color washSoft: "#14cdd6f4"
  readonly property color wash: "#1acdd6f4"
  readonly property color washBorder: "#1fcdd6f4"
  readonly property color washHover: "#24cdd6f4"
  readonly property color washStrong: "#29cdd6f4"
  readonly property color washBold: "#38cdd6f4"

  // State colours. Container state is the only thing in the popup carrying
  // colour, so these have to stay apart at the size of a dot.
  readonly property color green: "#a6e3a1"
  readonly property color amber: "#fab387"
  readonly property color yellow: "#f9e2af"
  readonly property color red: "#f38ba8"
  readonly property color grey: "#7f849c"
}
