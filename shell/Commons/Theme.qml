pragma Singleton

import QtQuick

// Generated by `zenix theme set catppuccin-macchiato` -- edit themes/catppuccin-macchiato.json, not this.
//
// One palette for every shell surface. These are the values hyprlock.conf and
// waybar-style.css already use, so a popup summoned over the bar reads as part
// of the same desktop rather than as a separate app.
QtObject {
  // Surfaces. `background` is the card itself, deliberately not opaque: the
  // layer rule in hyprland.lua blurs whatever sits behind it.
  readonly property color background: "#ec24273a"
  readonly property color elevated: "#14cad3f5"
  readonly property color scrim: "#66181926"

  // Hairlines. `border` outlines the card, `separator` divides rows inside it.
  readonly property color border: "#26cad3f5"
  readonly property color separator: "#14cad3f5"

  // Text. `muted` is the secondary line under a title; `faint` is for hints
  // that should register only when looked at directly.
  readonly property color foreground: "#cad3f5"
  readonly property color muted: "#a5adcb"
  readonly property color faint: "#6e738d"

  readonly property color accent: "#8aadf4"
  readonly property color selection: "#3d8aadf4"

  // Text and glyphs that sit *on* an accent fill. Not always white: on a light
  // accent -- any of the Catppuccin blues -- white reads as a smudge, so this
  // flips to the darkest surface instead.
  readonly property color accentForeground: "#181926"

  // Overlay washes, lightest first. Named by weight rather than by use so one
  // value can serve a fill and a hairline alike. They stay alpha rather than
  // becoming opaque surfaces: the cards are blurred by the layer rule in
  // hyprland.lua, and an opaque fill would throw that away.
  readonly property color washFaint: "#0dcad3f5"
  readonly property color washDim: "#12cad3f5"
  readonly property color washSoft: "#14cad3f5"
  readonly property color wash: "#1acad3f5"
  readonly property color washBorder: "#1fcad3f5"
  readonly property color washHover: "#24cad3f5"
  readonly property color washStrong: "#29cad3f5"
  readonly property color washBold: "#38cad3f5"

  // State colours. Container state is the only thing in the popup carrying
  // colour, so these have to stay apart at the size of a dot.
  readonly property color green: "#a6da95"
  readonly property color amber: "#f5a97f"
  readonly property color yellow: "#eed49f"
  readonly property color red: "#ed8796"
  readonly property color grey: "#8087a2"
}
