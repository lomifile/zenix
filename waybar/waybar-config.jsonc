{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "margin-top": 6,
  "margin-bottom": 0,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/cpu",
    "custom/memory",
    "network",
    "bluetooth",
    "custom/volume",
    "custom/battery",
    "custom/agenda"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 44,
    "separate-outputs": true,
    "rewrite": { "": "Desktop" }
  },

  "clock": {
    "format": "{:%a %d %b   %H:%M}",
    "interval": 30,
    "tooltip-format": "<span size='x-large' weight='bold'>{:%B %Y}</span>\n\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f5f5f7'><b>{}</b></span>",
        "days": "<span color='#f5f5f7'>{}</span>",
        "weeks": "<span color='#8e8e93'>W{}</span>",
        "weekdays": "<span color='#8e8e93'><b>{}</b></span>",
        "today": "<span color='#0a84ff'><b>{}</b></span>"
      }
    },
    // Spelled out rather than a bare `zenix-shell`: waybar inherits the
    // graphical session PATH, which SDDM sets to
    // /usr/local/sbin:/usr/local/bin:/usr/bin. ~/.local/bin comes from
    // zsh/.zshrc, which only interactive shells read.
    "on-click": "~/.local/bin/zenix-shell shell toggle zenix.calendar",
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // Today's agenda, read from the cache that `zenix agenda fetch` writes on a
  // systemd timer. The module never touches the network, so the tooltip is
  // instant and works offline.
  "custom/agenda": {
    "exec": "~/.config/waybar/scripts/agenda.py",
    "return-type": "json",
    "interval": 60,
    "on-click": "xdg-open https://calendar.google.com",
    "on-click-right": "systemctl --user start zenix-agenda.service"
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/statbar.sh cpu",
    "interval": 2,
    "tooltip": false
  },

  "custom/memory": {
    "exec": "~/.config/waybar/scripts/statbar.sh memory",
    "interval": 3,
    "tooltip": false
  },

  "custom/volume": {
    "exec": "~/.config/waybar/scripts/statbar.sh volume",
    "interval": 1,
    "on-click": "~/.local/bin/zenix-shell shell toggle zenix.audio",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip": false
  },

  "custom/battery": {
    "exec": "~/.config/waybar/scripts/statbar.sh battery",
    "interval": 10,
    "tooltip": false
  },

  "network": {
    "interval": 2,
    // Wi-Fi carries a strength icon, ethernet a plug: which link you are on
    // should be readable without the tooltip.
    "format-wifi": "{icon}  {bandwidthDownBytes}   {bandwidthUpBytes}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀  {bandwidthDownBytes}   {bandwidthUpBytes}",
    "format-disconnected": "󰤭 offline",
    "tooltip-format": "{ifname}  {ipaddr}",
    // Clicking is for picking a network, which only means something when
    // there is no cable. On ethernet it does nothing; disconnected it still
    // opens, since that is exactly when you want to join something.
    //
    // Spelled out for the same reason as the clock: waybar inherits the
    // graphical session PATH, which has no ~/.local/bin.
    "on-click": "nmcli -t -f TYPE,STATE device status | grep -q '^ethernet:connected' || ~/.local/bin/zenix-shell shell toggle zenix.wifi",
    "on-click-right": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\n{status}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    // Spelled out for the same reason as the clock: waybar inherits the
    // graphical session PATH, which has no ~/.local/bin.
    "on-click": "~/.local/bin/zenix-shell shell toggle zenix.bluetooth",
    "on-click-right": "blueman-manager"
  }
}
