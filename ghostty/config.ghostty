theme = catppuccin-mocha
font-family = ZedMono Nerd Font

# Add some nice looking padding
window-padding-x = 4
window-padding-y = 2

# Don't hang around
quit-after-last-window-closed = true

# Fixes issues with Ctrl-R
term = xterm-256color

# Opaque. The terminal paints its own background, and so does everything
# running inside it -- nvim, tmux, btop and fzf all used to hand theirs back to
# ghostty so the desktop read through, and no longer do. The compositor's blur
# still applies to the bar, the launcher and the popups, which stay translucent.
background-opacity = 1
